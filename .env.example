# Copy to `.env` and set values for production.

# Destination for the "Buy My Car" valuation form submissions.
# e.g. a Formspree endpoint, Forminator webhook, or your own API.
# Until set, the form validates and shows the success state without sending.
VITE_FORM_ENDPOINT=

# Optional base URL to relocate/self-host the "What's Your Car Worth" audio files.
# Leave blank to use the existing authorised hosted sources.
VITE_AUDIO_BASE=
